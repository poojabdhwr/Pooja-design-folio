---
/**
 * Home page — hero, proud projects, about, footer.
 *
 * Content lives directly in this file so it's easy to update.
 * Images live in /public — see IMAGE-CHECKLIST.md for the export list.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AboutSection from "../components/AboutSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FadeIn from "../components/FadeIn.astro";

// — Content —
const projects = [
  {
    href: "/cyberboxx", // Change to "/work/cyberboxx" if your file is inside src/pages/work/cyberboxx.astro
    image: "/projects/cyberboxx.jpg",
    imageAlt: "Cyberboxx case study cover",
    title: "Cyberboxx",
    blurb:
      "Redesigned a Canadian cybersecurity platform for Indian users, making digital threats easier to understand, prevent, and respond to.",
    showcases: ["Stakeholder management", "Craft"],
    disabled: false,
  },
  {
    href: "#",
    image: "/projects/kaavi.jpg",
    imageAlt: "Kaavi case study cover",
    title: "Kaavi",
    blurb:
      "A platform connecting traditional artisans and interior designers to make traditional craftsmanship easier to discover and commission.",
    showcases: ["Craft", "UX research"],
    disabled: true,
  },
];
---

<BaseLayout>
  <!-- Hero — pill nav nested inside via slot so it scrolls with the gradient -->
  <Hero>
    <Nav slot="nav" active="home" />
  </Hero>

  <!-- Proud projects -->
  <section class="mx-auto w-full max-w-[1540px] px-5 pb-16 md:px-[150px] md:pb-24">
    <FadeIn>
      <SectionTitle class="mb-8 md:mb-10">Proud projects</SectionTitle>
    </FadeIn>
    <div class="flex flex-col items-stretch gap-8 md:flex-row md:gap-6">
      {projects.map(({ disabled, ...cardProps }, i) => (
        <FadeIn
          class={`flex flex-1 min-w-0 ${disabled ? "cursor-not-allowed" : ""}`}
          delay={100 + i * 100}
        >
          {disabled ? (
            <div
              class="flex flex-1 min-w-0 pointer-events-none select-none opacity-60"
              inert
              aria-disabled="true"
            >
              <ProjectCard {...cardProps} />
            </div>
          ) : (
            <ProjectCard {...cardProps} />
          )}
        </FadeIn>
      ))}
    </div>
  </section>

  <!-- About me -->
  <FadeIn>
    <AboutSection />
  </FadeIn>

  <SiteFooter />
</BaseLayout>
