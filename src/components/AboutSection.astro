---
/**
 * About me — copy only (avatar removed).
 */
import SectionTitle from "./SectionTitle.astro";

const paragraphs = [
  "I'm a UX Design student, currently building my practice across digital products and interfaces.",
  "My projects have taken me across mobile experiences, dashboards, and accessibility led product redesigns, from research and audits to interaction design and prototyping.",
  "I enjoy getting hands on with little DIY projects, taking the longer route on walks, and trying places I've never eaten at before.",
];
---

<section id="about" class="mt-10 md:mt-16">
  <!-- Mobile -->
  <div class="flex flex-col items-center md:hidden">
    <div class="flex w-full flex-col gap-6 bg-surface-2 px-4 pt-6 pb-3">
      <SectionTitle>About me</SectionTitle>
      <div class="flex flex-col gap-4 text-body leading-[1.5] text-ink-2">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden w-full overflow-hidden bg-surface-2 md:block">
    <div
      class="relative mx-auto flex max-w-[1540px] items-center gap-10 px-[150px] py-8"
    >
      <div class="flex w-full flex-1 flex-col gap-6">
        <SectionTitle>About me</SectionTitle>
        <div class="flex flex-col gap-5 text-body text-ink-2">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
